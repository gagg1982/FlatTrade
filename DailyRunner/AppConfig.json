{
    "Api": {
        "AccessTokenFilePath": "../../../Tokens/FlatTrade.AccessToken.Token.Common",
        "Key": "",
        "Secret": "",
        "RedirectUrl": "http://localhost:9001/FlatTradeBroker/",
        "Uid": "",
        "Password": "", 
        "QrCode": "",

        "Throttling": {
            "RateLimiter": {
                "GlobalCallsPerSec": 20,
                "GlobalCallsPerMin": 500,
                "SleepForXMilliSecondsIfBreached": 50,

                "PerApiCalls": {
                    "GetSecurityInfoAsync": {
                        "CallsPerSec": 20,
                        "CallsPerMin": 100
                    },
                    "GetQuotesAsync": {
                        "CallsPerSec": 20,
                        "CallsPerMin": 400
                    },
                    "GetLinkedScripsAsync": {
                        "CallsPerSec": 20,
                        "CallsPerMin": 400
                    }
                }
            },
            "ConcurrencyOnOutstanding": {
                "GlobalCallsPerSec": 12,
                "GlobalCallsPerMin": 120,
                "PerApiCalls": {
                    "GetSecurityInfoAsync": {
                        "CallsPerSec": 12,
                        "CallsPerMin": 115
                    },
                    "GetQuotesAsync": {
                        "CallsPerSec": 10,
                        "CallsPerMin": 80
                    }
                }
            }
        }
    },

    "Database": {
        "ConnectionString": "Server=dbserver\\appdb,1436;Database=TradingApplication;Integrated Security = True; TrustServerCertificate=True;"
    },

    "ExchangeGenerator": {
        "Enabled": true,

        "WriteToFile": {
            "Enabled": true,
            "ChannelCapacity": 5,
            "CsvFilePath": "../../../CsvData/Exchange/"
        },
        "WriteToDb": {
            "Enabled": true,
            "ChannelCapacity": 5,
            "WriteBatchSizeInDb": 5000
        }
    },

    "StockInstrumentGenerator": {
        "Enabled": true,
        "InterestedExchanges": [ "NSE", "BSE" ],
        "InterestedInstrumentNamesInExchanges": [ "A", "B", "EQ" ],

        "WriteToDb": {
            "ChannelCapacity": 5000,
            "Enabled": true,
            "WriteBatchSizeInDb": 5000
        },
        "WriteToFile": {
            "ChannelCapacity": 5000,
            "Enabled": true,
            "CsvFilePath": "../../../CsvData/StockInstruments/"
        }
    },

    "StocksOhlcvGenerator": {
        "Enabled": true,

        "ListOfTradingSymbols": [],

        "DefaultPastDaysIfStartDateIsMissing": 5,
        "StartDate": "",
        "DateBatchSizeForOneMinutePrices": 10,
        "DateBatchSizeForDailyPrices": 10,
        "DailyPricesEnabled": true,
        "OneMinutePricesEnabled": true,

        "WriteToFile": {
            "Enabled": true,
            "ChannelCapacity": 5000,
            "CsvFilePath": "../../../CsvData/StocksOhlcv/"
        },
        "WriteToDb": {
            "Enabled": true,
            "ChannelCapacity": 5000,
            "WriteBatchSizeInDb": 5000
        }
    },

    "FillMissingOhlcv": {
        "Enabled": true,
        "DefaultPastDaysIfStartDateIsMissing": 200,
        "StartDate": "2026-02-01",
        "DailyPricesEnabled": true,
        "OneMinutePricesEnabled": true,

        "WriteToFile": {
            "Enabled": true,
            "ChannelCapacity": 5000,
            "CsvFilePath": "../../../CsvData/MissingStocksOhlcv/"
        },
        "WriteToDb": {
            "Enabled": true,
            "ChannelCapacity": 5000,
            "WriteBatchSizeInDb": 5000
        }
    },

    "BookKeeping": {
        "Enabled": true,

        "CalculateBrokerageAndTaxesFrom": "2026-02-01",

        "WriteToFile": {
            "Enabled": true,
            "ChannelCapacity": 5000,
            "CsvFilePath": "../../../CsvData/BookKeeping/"
        },
        "WriteToDb": {
            "Enabled": true,
            "ChannelCapacity": 5000,
            "WriteBatchSizeInDb": 5000
        }
    },    

    "Serilog": {
        "Using": [
            "Serilog.Sinks.Console",
            "Serilog.Sinks.File",
            "Serilog.Enrichers.Thread"
        ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "System": "Warning"
            }
        },
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    "outputTemplate": "[{Timestamp:HH:mm:ss.fff} | {Level:u3} | {SourceContext,-55} | {Message:lj}{NewLine}{Exception}"
                }
            },
            {
                "Name": "File",
                "Args": {
                    "path": "../../../Logs/DailyRunner-02-StockInstruments.log",
                    "rollingInterval": "Day",
                    "retainedFileCountLimit": 7,
                    "fileSizeLimitBytes": 104857600,
                    "outputTemplate": "[{Timestamp:HH:mm:ss.fff} | {Level:u3} | {SourceContext,-55} | {Message:lj}{NewLine}{Exception}"
                }
            }
        ],
        "Enrich": [
            "FromLogContext",
            "WithThreadId"
        ]
    }
}
